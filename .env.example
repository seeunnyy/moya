# 키 이름만 적는다. 실제 값은 .env.local에만 넣고 절대 커밋하지 않는다. (NEXT_PUBLIC_을 붙이지 않는다 — 브라우저로 가면 안 됨)

# 해커톤: 음성인식만 외부 API로 쓴다. (음성 출력은 브라우저 내장 speechSynthesis라 키가 없다)
# STT_PROVIDER: mock(기본, 시연용 예시 문장을 차례로 돌려줌) · openai(OpenAI 음성 변환 /v1/audio/transcriptions)
STT_PROVIDER=mock
# OpenAI API 키 (STT_PROVIDER=openai일 때). 서버에서만 읽는다
STT_API_KEY=
# OpenAI 음성 변환 모델. 비우면 gpt-transcribe. 예: gpt-4o-mini-transcribe
STT_MODEL=

# 베타: 사전 API, LLM (실시간 설명, 맥락 재순위)
# DICTIONARY_API_KEY=
# LLM_API_KEY=
